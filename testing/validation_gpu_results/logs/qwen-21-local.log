        "quantize_te": false,
        "low_vram": false,
        "model_kwargs": {
            "rgba": false
        },
        "compile": false,
        "extras_name_or_path": "/ai-toolkit/models/qwen21-extras",
        "vae_dtype": "float32"
    },
    "sample": {
        "sampler": "flowmatch",
        "sample_every": 2,
        "sample_start_step": 0,
        "width": 256,
        "height": 256,
        "samples": [
            {
                "prompt": "A large gold coin with a '\u20bd' mark is in the center on an empty background."
            }
        ],
        "neg": "",
        "seed": 42,
        "walk_seed": false,
        "guidance_scale": 3,
        "sample_steps": 4
    }
}

