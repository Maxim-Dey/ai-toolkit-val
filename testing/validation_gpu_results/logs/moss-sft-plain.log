        "force_first_sample": false,
        "disable_sampling": false,
        "dtype": "bf16",
        "num_workers": 0
    },
    "model": {
        "name_or_path": "OpenMOSS-Team/MOSS-Image-SFT",
        "arch": "moss_image",
        "quantize": false,
        "quantize_te": false,
        "low_vram": false,
        "model_kwargs": {
            "edit": false
        },
        "compile": false,
        "extras_name_or_path": "OpenMOSS-Team/MOSS-Image-SFT",
        "vae_dtype": "float32"
    },
    "sample": {
        "sampler": "flowmatch",
        "sample_every": 2,
        "sample_start_step": 0,
        "width": 256,
        "height": 256,
        "samples": [
            {
                "prompt": "A metal object on a neutral background."
            }
        ],
        "neg": "",
        "seed": 42,
        "walk_seed": false,
        "guidance_scale": 3,
        "sample_steps": 4
    }
}

