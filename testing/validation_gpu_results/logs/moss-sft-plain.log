            "cache_text_embeddings": true,
            "mask_path": "/ai-toolkit/testing/.gpu-acceptance/data/masks/train"
        }
    ],
    "val_datasets": [
        {
            "val_path": "/ai-toolkit/testing/.gpu-acceptance/data/val",
            "resolution": [
                256
            ],
            "val_every_n_steps": 2,
            "val_seed_noise": 42,
            "val_level_noise_n": 8,
            "val_seed_noise_n": 2
        },
        {
            "val_path": "/ai-toolkit/testing/.gpu-acceptance/data/val",
            "resolution": [
                256
            ],
            "val_every_n_steps": 2,
            "val_seed_noise": 42,
            "val_level_noise_n": 8,
            "val_seed_noise_n": 2,
            "mask_path": "/ai-toolkit/testing/.gpu-acceptance/data/masks/val"
        }
    ],
    "train": {
        "lr": 0.0001,
        "batch_size": 1,
        "steps": 3,
        "gradient_accumulation": 2,
        "train_unet": true,
        "train_text_encoder": false,
        "gradient_checkpointing": true,
        "noise_scheduler": "flowmatch",
        "optimizer": "adamw8bit",
        "timestep_type": "shift",
        "content_or_style": "balanced",
        "loss_type": "mse",
        "loss_target": "noise",
        "optimizer_params": {
            "weight_decay": 0.0001
